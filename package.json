{
  "name": "crud-api",
  "version": "1.0.0",
  "type": "module",
  "main": "main.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:nodemon": "nodemon --watch src --ext ts --exec \"tsx src/main.ts\"",
    "build": "tsc",
    "start": "node dist/main.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
