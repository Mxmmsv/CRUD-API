{
  "name": "crud-api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start:dev": "nodemon --watch src --ext ts --exec \"tsx src/main.ts\"",
    "start:prod": "npm run build && node dist/main.js",
    "build": "tsc && tsc-alias",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/server.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "nodemon": "^3.1.14",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
